<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.hallsync.controller.ProfileController">
    <Label text="Edit Profile" styleClass="page-title"/>
    <VBox spacing="10" maxWidth="400">
        <Label text="Full Name"/>
        <TextField fx:id="fullNameField"/>
        <Label text="Email"/>
        <TextField fx:id="emailField"/>
        <Label text="New Password (Optional)"/>
        <PasswordField fx:id="passwordField"/>
        
        <HBox spacing="10">
            <Button text="Save Profile" onAction="#handleSaveProfile"/>
        </HBox>
    </VBox>
</VBox>

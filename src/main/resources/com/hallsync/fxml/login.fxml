<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="513.0" prefWidth="527.0" styleClass="login-root" stylesheets="@/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hallsync.controller.LoginController">

    <VBox fx:id="loginBox" maxWidth="415.0" prefHeight="467.0" prefWidth="415.0" spacing="15" styleClass="login-box">
        <Label styleClass="page-title" text="HallSync" />
        <Label prefHeight="17.0" prefWidth="301.0" styleClass="subtitle" text="A Residential Hall Management for KUET" wrapText="true" />
        <TextField fx:id="usernameField" promptText="Username" />
        <PasswordField fx:id="passwordField" promptText="Password" />
        <Button fx:id="loginButton" onAction="#handleLogin" styleClass="action-button" text="Login" />
        <Label fx:id="statusLabel" styleClass="hint" text="" wrapText="true" />
        <Label styleClass="hint" text="Demo accounts: admin/admin · provost/provost · student/student" wrapText="true" />
      <StackPane.margin>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </StackPane.margin>
      <padding>
         <Insets left="20.0" top="20.0" />
      </padding>
      <effect>
         <Blend mode="RED" />
      </effect>
      <cursor>
         <Cursor fx:constant="OPEN_HAND" />
      </cursor>
    </VBox>
</StackPane>

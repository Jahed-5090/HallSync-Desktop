<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hallsync.controller.StaffController"
      spacing="18">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Hall Staff Directory" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="← Back to Home" styleClass="action-button" onAction="#goBack"/>
    </HBox>

    <Label text="All current staff members of the hall and their contact information."
           styleClass="subtitle" wrapText="true"/>

    <!-- Staff cards loaded dynamically -->
    <VBox fx:id="staffContainer" spacing="12"/>
</VBox>
